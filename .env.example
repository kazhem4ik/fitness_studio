# =================================================================
# FITNESS STUDIO MONOREPO — ENVIRONMENT CONFIGURATION TEMPLATE
# Скопируйте этот файл в .env и укажите реальные боевые значения:
#   cp .env.example .env
# =================================================================

# -----------------------------------------------------------------
# 1. TELEGRAM BOT SETTINGS (bot_service)
# -----------------------------------------------------------------
# Токен Telegram-бота (получить у @BotFather)
TG_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram ID администратора студии (для уведомлений о новых записях и админ-меню)
# Узнать свой ID можно через бота @userinfobot
ADMIN_CHAT_ID=123456789

# Базовый публичный URL сервера для входящих вебхуков (например: https://fit-nch.ru)
# Не требуется при запуске в режиме polling
WEBHOOK_HOST=https://fit-nch.ru

# Прокси для Telegram API (опционально, оставить пустым если не требуется)
# TG_PROXY_URL=http://user:password@proxy.example.com:8080

# Токен для интеграции с MAX (опционально)
MAX_BOT_TOKEN=

# -----------------------------------------------------------------
# 2. PLANNER SERVICE & CRM (planner_service)
# -----------------------------------------------------------------
# Подключение к базе данных (в Docker SQLite монтируется в папку /database)
DATABASE_URL=sqlite+aiosqlite:////database/planner.db

# Секретный ключ для подписи JWT-токенов авторизации тренеров/админов
# Сгенерировать: openssl rand -hex 32 или python -c "import secrets; print(secrets.token_urlsafe(32))"
PLANNER_SECRET_KEY=change_me_to_a_secure_random_secret_token

# Дефолтный логин и пароль первого администратора (хешируются при первом запуске)
PLANNER_ADMIN_LOGIN=admin
PLANNER_ADMIN_PASSWORD=change_this_password_on_first_run

# Время жизни сессионного токена (в минутах, 10080 = 7 дней)
JWT_EXPIRE_MINUTES=10080
JWT_ALGORITHM=HS256

# Telegram-уведомления для планировщика (может совпадать с настройками бота)
TG_ADMIN_CHAT_ID=123456789

# -----------------------------------------------------------------
# 3. WEB PUSH NOTIFICATIONS (VAPID)
# -----------------------------------------------------------------
# Ключи для PWA Push-уведомлений в браузере тренера
# Генерация ключей: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BExamplePublicKeyUrlSafeBase64_StringHere...
VAPID_PRIVATE_KEY=ExamplePrivateKeyUrlSafeBase64_StringHere...

# -----------------------------------------------------------------
# 4. РАСПИСАНИЕ И ПРАВИЛА ЗАПИСИ
# -----------------------------------------------------------------
STUDIO_OPEN_TIME=10:00
STUDIO_CLOSE_TIME=20:00
SLOT_DURATION=60
BUFFER_BEFORE=0
BUFFER_AFTER=0

# Настройки перерыва (для бота)
LUNCH_START=14:00
LUNCH_END=15:00
# Рабочие дни (0=Пн, 1=Вт, 2=Ср, 3=Чт, 4=Пт, 5=Сб, 6=Вс)
WORK_DAYS=0,1,2,3,4,5

# Время временного удержания слота при выборе клиентом (минут)
SLOT_RESERVATION_MINUTES=5

# -----------------------------------------------------------------
# 5. ЗАЩИТА ОТ СПАМА И БОТОВ (Rate Limits)
# -----------------------------------------------------------------
# Лимит попыток записи с одного IP за окно
RATE_LIMIT_IP_LIMIT=5
RATE_LIMIT_IP_WINDOW_SECONDS=3600

# Лимит попыток записи с одного номера телефона за окно
RATE_LIMIT_PHONE_LIMIT=3
RATE_LIMIT_PHONE_WINDOW_SECONDS=86400
